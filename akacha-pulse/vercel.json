{
  "rewrites": [
    { "source": "/", "destination": "/api/page?f=index.html" },
    { "source": "/index.html", "destination": "/api/page?f=index.html" },
    { "source": "/:f(app\\.js|styles\\.css|logo-dark\\.png|logo-light\\.png)", "destination": "/api/page?f=:f" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
